# ── Django Core ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
PSQL_DB_NAME=stayhub
PSQL_USER=postgres
PSQL_PASSWORD=your-db-password
PSQL_HOST=localhost
PSQL_PORT=5432
DB_SSL_REQUIRED=False

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-secure-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Brevo (email / OTP) ───────────────────────────────────────────────────────
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=10
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME=StayHub
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_LENGTH=6
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_USE_ASYNC=False

# ── Brevo SMTP ────────────────────────────────────────────────────────────────
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-brevo-smtp-login
SMTP_KEY=your-brevo-smtp-key

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts → Generate Key
# Set each field from the downloaded JSON file
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com
FIREBASE_ALLOW_DEV_TOKEN=True

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CHANNEL_USE_INMEMORY=False
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True
USE_ASYNC_NOTIFICATIONS=True

# ── Time Zone ─────────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata

# ── Client HMAC Signing ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Must match NEXT_PUBLIC_APP_SECRET in the webapp .env.local
APP_SECRET=change-me-generate-a-secure-hex-secret
REQUIRE_CLIENT_SIGNATURE=False

# ── Rate Limiting ─────────────────────────────────────────────────────────────
CLIENT_IP_RATE_LIMIT=600
CLIENT_IP_RATE_WINDOW_SECONDS=3600
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=

# ── Client Verification ────────────────────────────────────────────────────────
# HMAC secret shared between the backend and all first-party clients.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Must be the SAME value as NEXT_PUBLIC_APP_SECRET in the frontend .env.
APP_SECRET=bcd422800fd93e96eb598d7544999810ac073c33492f4bb1ce3b7760fc6ed576ef89968c7668aea8b20ea6d7f5a21993ece697c41f8021e33df30620f2182f6d

# Whether to enforce HMAC signatures on API requests.
# Defaults to True in production (DEBUG=False), False in development.
# Set explicitly to True/False to override.
REQUIRE_CLIENT_SIGNATURE=False

# Per-IP global rate-limit (requests within the window).
CLIENT_IP_RATE_LIMIT=600
CLIENT_IP_RATE_WINDOW_SECONDS=3600

CORS_ALLOW_ALL_ORIGINS=True

BREVO_API_KEY=
BREVO_API_KEY_FILE=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=10
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GharBazar
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_LENGTH=6
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_SECRET=
EMAIL_OTP_SECRET_FILE=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_API_KEY_FILE=
CLOUDINARY_API_SECRET_FILE=

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CHANNEL_USE_INMEMORY=False

TIME_ZONE=Asia/Kolkata

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True
USE_ASYNC_NOTIFICATIONS=True
USE_ASYNC_ANALYTICS=True
AUDIT_LOG_ENABLED=False
ANALYTICS_AGGREGATION_CRON="0 2 * * *"
CACHE_TTL_SECONDS=60
PROPERTY_LIST_CACHE_TTL_SECONDS=60
PROPERTY_TRENDING_CACHE_TTL_SECONDS=120
SEARCH_BACKEND=postgres
CORS_ALLOWED_ORIGINS=
DJANGO_SECRET_KEY_FILE=
JWT_SECRET_KEY_FILE=
DB_PASSWORD_FILE=
PSQL_PASSWORD_FILE=
